import json
from channels.generic.websocket import AsyncWebsocketConsumer
from channels.db import database_sync_to_async
from django.core.exceptions import ObjectDoesNotExist
from .models import Conversation, Message, Leader


class ChatConsumer(AsyncWebsocketConsumer):
    async def connect(self):
        self.conv_id = self.scope['url_route']['kwargs']['conv_id']
        self.room_group_name = f'chat_{self.conv_id}'
        self.user = self.scope.get('user')
        
        # Check if user is authenticated leader or anonymous session
        self.is_leader = False
        self.leader_id = None
        self.anon_id = None
        
        # Try leader session auth
        session = self.scope.get('session', {})
        if 'leader_id' in session:
            self.is_leader = True
            self.leader_id = session['leader_id']
        
        # Try anonymous session
        elif 'anon_id' in session:
            self.anon_id = session['anon_id']
        
        # Validate conversation access
        if not await self.can_access_conversation():
            await self.close()
            return
        
        # Join room group
        await self.channel_layer.group_add(
            self.room_group_name,
            self.channel_name
        )
        await self.accept()
        
        # Notify others that user joined (online status)
        await self.channel_layer.group_send(
            self.room_group_name,
            {
                'type': 'user_online',
                'is_leader': self.is_leader,
            }
        )

    async def disconnect(self, close_code):
        # Leave room group
        await self.channel_layer.group_discard(
            self.room_group_name,
            self.channel_name
        )
        
        # Notify others that user left
        await self.channel_layer.group_send(
            self.room_group_name,
            {
                'type': 'user_offline',
                'is_leader': self.is_leader,
            }
        )

    async def receive(self, text_data):
        data = json.loads(text_data)
        msg_type = data.get('type', 'message')
        
        if msg_type == 'message':
            await self.handle_chat_message(data)
        elif msg_type == 'typing':
            await self.handle_typing(data)
        elif msg_type == 'read_receipt':
            await self.handle_read_receipt(data)

    async def handle_chat_message(self, data):
        body = data.get('message', '').strip()
        if not body:
            return
        
        # Determine sender
        if self.is_leader:
            sender_type = 'leader'
            sender_name = await self.get_leader_name()
        else:
            sender_type = 'anon'
            sender_name = 'You (Anonymous)'
        
        # Save to database
        message = await self.save_message(body, sender_type)
        
        # Broadcast to room
        await self.channel_layer.group_send(
            self.room_group_name,
            {
                'type': 'chat_message',
                'message': body,
                'sender_type': sender_type,
                'sender_name': sender_name,
                'message_id': str(message.id),
                'timestamp': message.created_at.strftime('%I:%M %p'),
                'is_leader': self.is_leader,
            }
        )

    async def handle_typing(self, data):
        is_typing = data.get('is_typing', False)
        await self.channel_layer.group_send(
            self.room_group_name,
            {
                'type': 'typing_indicator',
                'is_typing': is_typing,
                'is_leader': self.is_leader,
            }
        )

    async def handle_read_receipt(self, data):
        message_id = data.get('message_id')
        await self.mark_message_read(message_id)
        await self.channel_layer.group_send(
            self.room_group_name,
            {
                'type': 'read_receipt',
                'message_id': message_id,
                'is_leader': self.is_leader,
            }
        )

    # ========== EVENT HANDLERS ==========
    
    async def chat_message(self, event):
        await self.send(text_data=json.dumps({
            'type': 'message',
            'message': event['message'],
            'sender_type': event['sender_type'],
            'sender_name': event['sender_name'],
            'message_id': event['message_id'],
            'timestamp': event['timestamp'],
            'is_me': (event['is_leader'] == self.is_leader),
        }))

    async def typing_indicator(self, event):
        # Don't echo back to sender
        if event['is_leader'] == self.is_leader:
            return
        await self.send(text_data=json.dumps({
            'type': 'typing',
            'is_typing': event['is_typing'],
            'is_leader': event['is_leader'],
        }))

    async def user_online(self, event):
        await self.send(text_data=json.dumps({
            'type': 'online',
            'is_leader': event['is_leader'],
        }))

    async def user_offline(self, event):
        await self.send(text_data=json.dumps({
            'type': 'offline',
            'is_leader': event['is_leader'],
        }))

    async def read_receipt(self, event):
        await self.send(text_data=json.dumps({
            'type': 'read',
            'message_id': event['message_id'],
        }))

    # ========== DATABASE HELPERS ==========
    
    @database_sync_to_async
    def can_access_conversation(self):
        try:
            conv = Conversation.objects.get(id=self.conv_id)
            if self.is_leader:
                return str(conv.leader.id) == self.leader_id
            else:
                return str(conv.anon_id) == self.anon_id
        except ObjectDoesNotExist:
            return False

    @database_sync_to_async
    def save_message(self, body, sender_type):
        conv = Conversation.objects.get(id=self.conv_id)
        return Message.objects.create(
            conversation=conv,
            sender_type=sender_type,
            body=body
        )

    @database_sync_to_async
    def get_leader_name(self):
        try:
            leader = Leader.objects.get(id=self.leader_id)
            return leader.name
        except ObjectDoesNotExist:
            return 'Support Leader'

    @database_sync_to_async
    def mark_message_read(self, message_id):
        try:
            msg = Message.objects.get(id=message_id)
            msg.is_read = True
            msg.save(update_fields=['is_read'])
        except ObjectDoesNotExist:
            pass