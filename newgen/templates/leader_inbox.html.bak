{% load static %}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Inbox - Whisper Line</title>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "secondary-fixed": "#ccebc7", "primary-fixed": "#d2e4fb",
              "on-primary-fixed": "#0b1d2d", "tertiary": "#141614",
              "tertiary-container": "#292a28", "surface-container-lowest": "#ffffff",
              "outline-variant": "#c4c6cd", "on-error": "#ffffff",
              "error-container": "#ffdad6", "surface-container-low": "#f0f3ff",
              "tertiary-fixed-dim": "#c7c6c4", "on-tertiary": "#ffffff",
              "on-tertiary-container": "#91918f", "outline": "#74777d",
              "surface-container-highest": "#d8e3fa", "on-tertiary-fixed-variant": "#464745",
              "on-secondary-container": "#506b4f", "surface-variant": "#d8e3fa",
              "surface-container-high": "#dee8ff", "on-secondary-fixed": "#07200b",
              "on-secondary": "#ffffff", "on-primary-fixed-variant": "#38485a",
              "on-primary-container": "#8192a7", "on-error-container": "#93000a",
              "inverse-surface": "#263142", "error": "#ba1a1a", "tertiary-fixed": "#e3e2e0",
              "surface-bright": "#f9f9ff", "inverse-primary": "#b7c8de", "secondary": "#4a6549",
              "on-surface-variant": "#44474c", "on-tertiary-fixed": "#1a1c1a",
              "on-primary": "#ffffff", "secondary-container": "#ccebc7",
              "on-background": "#111c2c", "surface": "#f9f9ff",
              "inverse-on-surface": "#ebf1ff", "background": "#f9f9ff",
              "primary-container": "#1a2b3c", "surface-dim": "#cfdaf1",
              "on-secondary-fixed-variant": "#334d33", "primary": "#041627",
              "primary-fixed-dim": "#b7c8de", "on-surface": "#111c2c",
              "surface-tint": "#4f6073", "surface-container": "#e7eeff",
              "secondary-fixed-dim": "#b0cfad"
            },
            borderRadius: { DEFAULT: "1rem", lg: "2rem", xl: "3rem", full: "9999px" },
            spacing: {
              "stack-sm": "12px", "stack-lg": "48px", "container-max": "1200px",
              "stack-md": "24px", "gutter": "24px", "unit": "8px",
              "margin-desktop": "64px", "margin-mobile": "20px"
            },
            fontFamily: {
              "display-lg": ["Quicksand"], "title-md": ["Quicksand"], "headline-lg": ["Quicksand"],
              "caption": ["Quicksand"], "label-sm": ["Quicksand"], "headline-lg-mobile": ["Quicksand"],
              "body-md": ["Quicksand"], "body-lg": ["Quicksand"]
            },
            fontSize: {
              "display-lg": ["40px", {lineHeight: "48px", letterSpacing: "-0.02em", fontWeight: "700"}],
              "title-md": ["20px", {lineHeight: "28px", fontWeight: "600"}],
              "headline-lg": ["32px", {lineHeight: "40px", fontWeight: "600"}],
              "caption": ["12px", {lineHeight: "16px", fontWeight: "500"}],
              "label-sm": ["14px", {lineHeight: "20px", letterSpacing: "0.01em", fontWeight: "600"}],
              "headline-lg-mobile": ["24px", {lineHeight: "32px", fontWeight: "600"}],
              "body-md": ["16px", {lineHeight: "24px", fontWeight: "400"}],
              "body-lg": ["18px", {lineHeight: "28px", fontWeight: "500"}]
            }
          },
        },
      }
    </script>
<style>
        body { font-family: 'Quicksand', sans-serif; background-color: #f9f9ff; -webkit-font-smoothing: antialiased; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; display: inline-block; vertical-align: middle; }
        .message-preview { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
        .glass-header { background: rgba(249, 249, 255, 0.8); backdrop-filter: blur(12px); }
        .thread-item:active { transform: scale(0.98); }
    </style>
<base target="_blank">
</head>
<body class="text-on-surface">
<!-- TopAppBar -->
<header class="glass-header fixed top-0 w-full z-50 transition-all duration-200">
<div class="flex items-center justify-between px-margin-mobile h-16 w-full max-w-container-max mx-auto">
<div class="flex items-center gap-4">
<a href="{% url 'directory' %}" class="material-symbols-outlined text-primary hover:opacity-80 transition-opacity active:scale-95">arrow_back</a>
<h1 class="font-title-md text-title-md text-primary">Inbox</h1>
</div>
<div class="flex items-center gap-4">
<div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center overflow-hidden border border-primary/5">
<span class="material-symbols-outlined text-on-surface-variant">cloud</span>
</div>
</div>
</div>
</header>

<main class="pt-24 pb-32 px-margin-mobile max-w-[720px] mx-auto min-h-screen">
<!-- Reassuring Note Section -->
<section class="mb-stack-md animate-in fade-in slide-in-from-top duration-700">
<div class="bg-secondary-container/20 border border-secondary/10 rounded-lg p-4 flex items-start gap-3">
<span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">verified_user</span>
<div>
<p class="font-label-sm text-label-sm text-secondary font-bold">Privacy Guaranteed</p>
<p class="font-caption text-caption text-on-surface-variant">Your identity is never shared with leaders. You appear as an anonymous contributor in every conversation.</p>
</div>
</div>
</section>

<!-- Search -->
<div class="mb-stack-md relative">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/50">search</span>
<input class="w-full h-12 pl-12 pr-4 rounded-full border-none bg-white shadow-[0_10px_30px_rgba(26,43,60,0.05)] focus:ring-2 focus:ring-secondary/20 font-body-md text-body-md placeholder:text-on-surface-variant/40" placeholder="Search conversations..." type="text"/>
</div>

<!-- Threads List -->
<div class="space-y-stack-sm">
{% for conv in conversations %}
{% with last_msg=conv.messages.last %}
<a href="{% url 'chat' conv.leader.id %}" class="thread-item group cursor-pointer bg-white p-4 rounded-lg shadow-[0_10px_30px_rgba(26,43,60,0.05)] border border-primary/5 hover:border-secondary/20 transition-all duration-200 block">
<div class="flex gap-4">
<div class="relative flex-shrink-0">
<div class="w-14 h-14 rounded-full overflow-hidden">
<img class="w-full h-full object-cover" src="https://ui-avatars.com/api/?name={{ conv.leader.name|urlencode }}&background=4a6549&color=fff&size=120" alt="{{ conv.leader.name }}">
</div>
{% if conv.leader.is_online %}
<div class="absolute bottom-0 right-0 w-4 h-4 bg-secondary border-2 border-white rounded-full"></div>
{% endif %}
</div>
<div class="flex-1 min-w-0">
<div class="flex justify-between items-start mb-1">
<h3 class="font-title-md text-title-md text-primary truncate">{{ conv.leader.name }}</h3>
<span class="font-caption text-caption {% if not last_msg.is_read and last_msg.sender_type == 'leader' %}text-secondary font-bold{% else %}text-on-surface-variant{% endif %} whitespace-nowrap">
    {% if last_msg %}{{ last_msg.created_at|timesince }} ago{% else %}{{ conv.created_at|timesince }} ago{% endif %}
</span>
</div>
<div class="flex items-center justify-between">
<p class="font-body-md text-body-md text-on-surface-variant message-preview {% if not last_msg.is_read and last_msg.sender_type == 'leader' %}font-semibold{% else %}opacity-70{% endif %}">
    {% if last_msg %}{{ last_msg.body|truncatechars:50 }}{% else %}Start a conversation...{% endif %}
</p>
{% if not last_msg.is_read and last_msg.sender_type == 'leader' %}
<div class="ml-2 w-2.5 h-2.5 bg-secondary rounded-full flex-shrink-0"></div>
{% endif %}
</div>
</div>
</div>
</a>
{% endwith %}
{% empty %}
<div class="text-center py-stack-lg">
<div class="w-16 h-16 mx-auto mb-4 rounded-full bg-surface-container-low flex items-center justify-center">
<span class="material-symbols-outlined text-4xl text-on-surface-variant/30">chat_bubble</span>
</div>
<h3 class="font-title-md text-title-md text-primary mb-2">No conversations yet</h3>
<p class="font-body-md text-body-md text-on-surface-variant max-w-xs mx-auto">Browse our leaders and start an anonymous conversation whenever you're ready.</p>
<a href="{% url 'directory' %}" class="inline-block mt-4 bg-secondary text-white font-label-sm py-3 px-6 rounded-full hover:opacity-90 transition-all">Find a Leader</a>
</div>
{% endfor %}
</div>

<!-- Empty State Visual Cue -->
{% if conversations %}
<div class="mt-stack-lg text-center opacity-30">
<span class="material-symbols-outlined text-4xl mb-2">shield_lock</span>
<p class="font-caption text-caption">End-to-end encrypted & fully anonymous</p>
</div>
{% endif %}
</main>

<!-- BottomNavBar -->
<nav class="fixed bottom-0 w-full z-50 flex justify-around items-center h-20 px-4 pb-safe bg-surface/80 backdrop-blur-md shadow-[0_-10px_30px_rgba(26,43,60,0.05)]">
<a class="flex flex-col items-center justify-center text-on-surface-variant opacity-70 hover:bg-surface-container-low transition-colors px-4 py-1 rounded-xl transition-transform duration-200 active:scale-90" href="{% url 'directory' %}">
<span class="material-symbols-outlined">group</span>
<span class="font-label-sm text-label-sm">Leaders</span>
</a>
<a class="flex flex-col items-center justify-center text-secondary font-bold bg-secondary-container/20 rounded-xl px-4 py-1 transition-transform duration-200 active:scale-90" href="{% url 'stranger_inbox' %}">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">chat_bubble</span>
<span class="font-label-sm text-label-sm">Inbox</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant opacity-70 hover:bg-surface-container-low transition-colors px-4 py-1 rounded-xl transition-transform duration-200 active:scale-90" href="#">
<span class="material-symbols-outlined">person</span>
<span class="font-label-sm text-label-sm">Profile</span>
</a>
</nav>

<script>
window.addEventListener('scroll', () => {
    const header = document.querySelector('.glass-header');
    if (window.scrollY > 20) {
        header.classList.add('shadow-sm', 'bg-surface/95');
    } else {
        header.classList.remove('shadow-sm', 'bg-surface/95');
    }
});
</script>
</body>
</html><!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Whisper Line - Leader Inbox</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .active-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #4a6549; /* secondary */
        }
        .presence-online {
            position: absolute;
            bottom: 2px;
            right: 2px;
            width: 10px;
            height: 10px;
            background-color: #4a6549;
            border: 2px solid white;
            border-radius: 50%;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d8e3fa;
            border-radius: 10px;
        }
        .glass-overlay {
            backdrop-filter: blur(15px);
            background: rgba(255, 255, 255, 0.15);
        }
    </style>
<!-- Tailwind Config -->
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-secondary-fixed-variant": "#334d33",
                        "error": "#ba1a1a",
                        "primary-container": "#1a2b3c",
                        "on-error-container": "#93000a",
                        "surface-variant": "#d8e3fa",
                        "primary-fixed-dim": "#b7c8de",
                        "tertiary-fixed-dim": "#c7c6c4",
                        "outline": "#74777d",
                        "on-primary-fixed": "#0b1d2d",
                        "on-background": "#111c2c",
                        "tertiary-fixed": "#e3e2e0",
                        "secondary": "#4a6549",
                        "surface-container-lowest": "#ffffff",
                        "surface-dim": "#cfdaf1",
                        "tertiary": "#141614",
                        "surface-container-low": "#f0f3ff",
                        "surface-bright": "#f9f9ff",
                        "secondary-container": "#ccebc7",
                        "on-surface-variant": "#44474c",
                        "surface-tint": "#4f6073",
                        "outline-variant": "#c4c6cd",
                        "background": "#f9f9ff",
                        "on-primary-fixed-variant": "#38485a",
                        "on-error": "#ffffff",
                        "on-secondary-fixed": "#07200b",
                        "on-primary": "#ffffff",
                        "on-tertiary-fixed": "#1a1c1a",
                        "surface-container": "#e7eeff",
                        "inverse-on-surface": "#ebf1ff",
                        "on-surface": "#111c2c",
                        "tertiary-container": "#292a28",
                        "secondary-fixed": "#ccebc7",
                        "primary-fixed": "#d2e4fb",
                        "surface-container-high": "#dee8ff",
                        "inverse-primary": "#b7c8de",
                        "surface": "#f9f9ff",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed-variant": "#464745",
                        "surface-container-highest": "#d8e3fa",
                        "secondary-fixed-dim": "#b0cfad",
                        "inverse-surface": "#263142",
                        "on-tertiary-container": "#91918f",
                        "on-secondary-container": "#506b4f",
                        "error-container": "#ffdad6",
                        "on-tertiary": "#ffffff",
                        "primary": "#041627",
                        "on-primary-container": "#8192a7"
                    },
                    "borderRadius": {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "margin-desktop": "64px",
                        "stack-md": "24px",
                        "stack-lg": "48px",
                        "stack-sm": "12px",
                        "margin-mobile": "20px",
                        "gutter": "24px",
                        "container-max": "1200px",
                        "unit": "8px"
                    },
                    "fontFamily": {
                        "label-sm": ["Quicksand"],
                        "caption": ["Quicksand"],
                        "display-lg": ["Quicksand"],
                        "body-lg": ["Quicksand"],
                        "headline-lg-mobile": ["Quicksand"],
                        "headline-lg": ["Quicksand"],
                        "title-md": ["Quicksand"],
                        "body-md": ["Quicksand"]
                    },
                    "fontSize": {
                        "label-sm": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600"}],
                        "caption": ["12px", {"lineHeight": "16px", "fontWeight": "500"}],
                        "display-lg": ["40px", {"lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "500"}],
                        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "fontWeight": "600"}],
                        "title-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
</head>
<body class="bg-surface text-on-surface min-h-screen font-body-md flex flex-col">
<!-- TopAppBar -->
<header class="bg-surface dark:bg-surface flex items-center justify-between px-margin-mobile h-16 w-full max-w-container-max mx-auto z-40 fixed top-0 left-0 right-0">
<div class="flex items-center gap-4">
<h1 class="font-display-lg text-display-lg text-primary dark:text-primary-fixed tracking-tight">Whisper Line</h1>
</div>
<div class="flex items-center gap-4">
<button class="hover:opacity-80 transition-opacity active:scale-95 text-primary">
<span class="material-symbols-outlined text-[24px]">settings</span>
</button>
<div class="w-10 h-10 rounded-full overflow-hidden border border-primary/10">
<img class="w-full h-full object-cover" data-alt="A professional headshot of a community leader, a woman in her late 30s with a kind and supportive expression. She is set against a soft-focus, minimalist office background with sage green and warm off-white tones. The lighting is bright and airy, evoking a sense of psychological safety and professional confidentiality." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBeo8j2N5Ww4-pRyFXZrdk65ihBhgwCiJUxDDAxpYeWReXPdgMhRarzm-nZ0oLs1uDgX-T9BZ1Iur83EzKhTJmnVcOZIBJ5YLUomqEuzIHXbNNnvh8Uf0mfU5r2EUXxnN8QhfUEplBJjb-O1K3tfnTY3Gb5D6qyszmVfF3nxH6lhcSkJm52d1tSDf6eQQ31Vcz4PeHEjx4GLH8_HSnMDrHr3ySPgz4c9F7pxXI288t1e2LZxVe1JZ8Q"/>
</div>
</div>
</header>
<main class="flex-grow flex pt-16 h-screen overflow-hidden">
<!-- Sidebar / Thread List -->
<aside class="w-full md:w-80 lg:w-96 border-r border-primary/5 bg-surface flex flex-col h-full">
<div class="p-margin-mobile">
<h2 class="font-title-md text-title-md text-primary mb-4">Conversations</h2>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant opacity-50">search</span>
<input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border-none rounded-full text-label-sm focus:ring-secondary/30" placeholder="Search threads..." type="text"/>
</div>
</div>
<div class="flex-grow overflow-y-auto custom-scrollbar px-2 pb-24">
<!-- Thread Items -->
<div class="flex flex-col gap-1">
<!-- Active Thread -->
<div class="flex items-center gap-4 p-4 rounded-xl bg-secondary-container/20 cursor-pointer transition-all duration-200">
<div class="relative w-12 h-12 flex-shrink-0 bg-surface-container-highest rounded-full flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-[28px]">person</span>
<div class="presence-online"></div>
</div>
<div class="flex-grow overflow-hidden">
<div class="flex justify-between items-center mb-1">
<span class="font-label-sm text-label-sm text-primary">Anonymous #1</span>
<span class="font-caption text-caption text-on-surface-variant">2m ago</span>
</div>
<p class="text-label-sm text-on-secondary truncate font-semibold">I'm feeling much better today, thank you.</p>
</div>
<div class="w-2 h-2 bg-secondary rounded-full"></div>
</div>
<!-- Inactive Thread -->
<div class="flex items-center gap-4 p-4 rounded-xl hover:bg-surface-container-low cursor-pointer transition-all duration-200">
<div class="relative w-12 h-12 flex-shrink-0 bg-surface-container-highest rounded-full flex items-center justify-center opacity-70">
<span class="material-symbols-outlined text-primary text-[28px]">person</span>
</div>
<div class="flex-grow overflow-hidden">
<div class="flex justify-between items-center mb-1">
<span class="font-label-sm text-label-sm text-primary">Anonymous #2</span>
<span class="font-caption text-caption text-on-surface-variant">1h ago</span>
</div>
<p class="text-label-sm text-on-surface-variant truncate">Is it possible to remain totally private?</p>
</div>
</div>
<!-- Inactive Thread -->
<div class="flex items-center gap-4 p-4 rounded-xl hover:bg-surface-container-low cursor-pointer transition-all duration-200">
<div class="relative w-12 h-12 flex-shrink-0 bg-surface-container-highest rounded-full flex items-center justify-center opacity-70">
<span class="material-symbols-outlined text-primary text-[28px]">person</span>
<div class="presence-online bg-outline-variant"></div>
</div>
<div class="flex-grow overflow-hidden">
<div class="flex justify-between items-center mb-1">
<span class="font-label-sm text-label-sm text-primary">Anonymous #3</span>
<span class="font-caption text-caption text-on-surface-variant">3h ago</span>
</div>
<p class="text-label-sm text-on-surface-variant truncate">I have a question about the group meeting.</p>
</div>
</div>
</div>
</div>
</aside>
<!-- Main View: Chat Interface -->
<section class="hidden md:flex flex-grow flex-col h-full bg-white relative">
<!-- Chat Header -->
<div class="h-16 flex items-center justify-between px-6 border-b border-primary/5">
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-surface-container-highest flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-[18px]">person</span>
</div>
<div>
<h3 class="font-label-sm text-label-sm text-primary">Anonymous #1</h3>
<p class="font-caption text-caption text-secondary">Active now</p>
</div>
</div>
<div class="flex gap-2">
<button class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-surface-container-low transition-colors">
<span class="material-symbols-outlined">call</span>
</button>
<button class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-surface-container-low transition-colors">
<span class="material-symbols-outlined">more_vert</span>
</button>
</div>
</div>
<!-- Messages Area -->
<div class="flex-grow overflow-y-auto p-6 custom-scrollbar space-y-stack-md flex flex-col">
<!-- Received Message (User) -->
<div class="max-w-[720px] w-full self-start flex gap-3">
<div class="flex-shrink-0 mt-auto mb-1">
<div class="w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center">
<span class="material-symbols-outlined text-[14px]">person</span>
</div>
</div>
<div class="bg-secondary/15 text-primary p-4 rounded-[20px] rounded-bl-none shadow-sm max-w-[85%]">
<p class="text-body-md font-body-md">Thank you for listening yesterday. It really helped to just say those things out loud.</p>
<span class="block text-[10px] mt-2 opacity-60">10:42 AM</span>
</div>
</div>
<!-- Sent Message (Leader) -->
<div class="max-w-[720px] w-full self-end flex justify-end gap-3">
<div class="bg-primary text-white p-4 rounded-[20px] rounded-br-none shadow-sm max-w-[85%]">
<p class="text-body-md font-body-md">You're very welcome. It takes a lot of courage to be that vulnerable. How are you feeling this morning?</p>
<span class="block text-[10px] mt-2 opacity-60 text-right">10:45 AM</span>
</div>
<div class="flex-shrink-0 mt-auto mb-1">
<div class="w-6 h-6 rounded-full overflow-hidden border border-primary/10">
<img class="w-full h-full object-cover" data-alt="A tiny profile avatar of a female community leader with a warm, empathetic smile. The lighting is gentle and flattering." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDqgElgHztvgUyh9yoeYWgkfZyI_zApJriTFAwiM5CheOc3sgyCew90Z53KHDRf7ez5HcwBN7cnj7t3uEnNcUuTLyl8aZgiC_w8QvbH1zuMDWOI7Bs_xbhq6bljoVuAbA-sOpkvmp4qB7GEUzIPEUtR42WctMyPNI0BgdLS9Rsclt-Ia5JvOxrqfE8xmcwVhTjTiePFZWfa8ymn651NKF7vnDhwFIwv4qprKJDXAt05IWZeJtB1e-TY"/>
</div>
</div>
</div>
<!-- Received Message (User) -->
<div class="max-w-[720px] w-full self-start flex gap-3">
<div class="flex-shrink-0 mt-auto mb-1">
<div class="w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center">
<span class="material-symbols-outlined text-[14px]">person</span>
</div>
</div>
<div class="bg-secondary/15 text-primary p-4 rounded-[20px] rounded-bl-none shadow-sm max-w-[85%]">
<p class="text-body-md font-body-md">I'm feeling much better today, thank you. A lot more clear-headed.</p>
<span class="block text-[10px] mt-2 opacity-60">2m ago</span>
</div>
</div>
<!-- Typing Indicator (Mock) -->
<div class="self-start flex gap-1 items-center px-4 py-2 opacity-50">
<div class="w-1.5 h-1.5 bg-primary rounded-full animate-bounce"></div>
<div class="w-1.5 h-1.5 bg-primary rounded-full animate-bounce delay-75"></div>
<div class="w-1.5 h-1.5 bg-primary rounded-full animate-bounce delay-150"></div>
</div>
</div>
<!-- Input Area -->
<div class="p-6 bg-white">
<div class="max-w-[720px] mx-auto relative flex items-end gap-3">
<div class="flex-grow relative">
<textarea class="w-full bg-surface-container-low border border-primary/10 focus:border-secondary focus:ring-1 focus:ring-secondary/20 rounded-xl px-4 py-3 text-body-md resize-none transition-all duration-200 min-h-[52px] max-h-[150px] custom-scrollbar" placeholder="Reply with kindness..." rows="1"></textarea>
<div class="absolute right-3 bottom-3 flex gap-2">
<button class="text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">sentiment_satisfied</span>
</button>
<button class="text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">attach_file</span>
</button>
</div>
</div>
<button class="bg-secondary text-white w-12 h-12 rounded-full flex items-center justify-center shadow-lg hover:shadow-secondary/20 active:scale-90 transition-all duration-200">
<span class="material-symbols-outlined">send</span>
</button>
</div>
</div>
</section>
<!-- Mobile Empty State View (Optional Overlay or if no threads) -->
<div class="hidden absolute inset-0 bg-surface flex-col items-center justify-center p-stack-lg text-center z-10" id="empty-state">
<div class="w-64 h-64 mb-8">

</div>
<h3 class="font-title-md text-title-md text-primary mb-2">No conversations yet</h3>
<p class="text-body-md text-on-surface-variant max-w-xs mx-auto">When someone reaches out to the line, their message will appear here. Thank you for being a supportive presence.</p>
</div>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 w-full z-50 flex justify-around items-center h-20 px-4 pb-safe bg-surface/80 backdrop-blur-md shadow-[0_-10px_30px_rgba(26,43,60,0.05)]">
<a class="flex flex-col items-center justify-center text-secondary dark:text-secondary-fixed-dim font-bold bg-secondary-container/20 rounded-xl px-4 py-1 transition-transform duration-200 active:scale-90" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">chat_bubble</span>
<span class="font-label-sm text-label-sm">Inbox</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant dark:text-on-surface-variant opacity-70 hover:bg-surface-container-low transition-colors duration-200 active:scale-90" href="#">
<span class="material-symbols-outlined">group</span>
<span class="font-label-sm text-label-sm">Leaders</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant dark:text-on-surface-variant opacity-70 hover:bg-surface-container-low transition-colors duration-200 active:scale-90" href="#">
<span class="material-symbols-outlined">person</span>
<span class="font-label-sm text-label-sm">Profile</span>
</a>
</nav>
<script>
        // Micro-interaction for expanding textarea
        const tx = document.getElementsByTagName("textarea");
        for (let i = 0; i < tx.length; i++) {
            tx[i].setAttribute("style", "height:" + (tx[i].scrollHeight) + "px;overflow-y:hidden;");
            tx[i].addEventListener("input", OnInput, false);
        }

        function OnInput() {
            this.style.height = 0;
            this.style.height = (this.scrollHeight) + "px";
        }

        // Logic for highlighting active thread
        const threadItems = document.querySelectorAll('.cursor-pointer');
        threadItems.forEach(item => {
            item.addEventListener('click', () => {
                threadItems.forEach(i => i.classList.remove('bg-secondary-container/20'));
                item.classList.add('bg-secondary-container/20');
            });
        });
    </script>
</body></html>