{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>
<title>Whisper Line - Anonymous Chat</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-secondary-fixed-variant": "#334d33", "error": "#ba1a1a",
              "primary-container": "#1a2b3c", "on-error-container": "#93000a",
              "surface-variant": "#d8e3fa", "primary-fixed-dim": "#b7c8de",
              "tertiary-fixed-dim": "#c7c6c4", "outline": "#74777d",
              "on-primary-fixed": "#0b1d2d", "on-background": "#111c2c",
              "tertiary-fixed": "#e3e2e0", "secondary": "#4a6549",
              "surface-container-lowest": "#ffffff", "surface-dim": "#cfdaf1",
              "tertiary": "#141614", "surface-container-low": "#f0f3ff",
              "surface-bright": "#f9f9ff", "secondary-container": "#ccebc7",
              "on-surface-variant": "#44474c", "surface-tint": "#4f6073",
              "outline-variant": "#c4c6cd", "background": "#f9f9ff",
              "on-primary-fixed-variant": "#38485a", "on-error": "#ffffff",
              "on-secondary-fixed": "#07200b", "on-primary": "#ffffff",
              "on-tertiary-fixed": "#1a1c1a", "surface-container": "#e7eeff",
              "inverse-on-surface": "#ebf1ff", "on-surface": "#111c2c",
              "tertiary-container": "#292a28", "secondary-fixed": "#ccebc7",
              "primary-fixed": "#d2e4fb", "surface-container-high": "#dee8ff",
              "inverse-primary": "#b7c8de", "surface": "#f9f9ff",
              "on-secondary": "#ffffff", "on-tertiary-fixed-variant": "#464745",
              "surface-container-highest": "#d8e3fa", "secondary-fixed-dim": "#b0cfad",
              "inverse-surface": "#263142", "on-tertiary-container": "#91918f",
              "on-secondary-container": "#506b4f", "error-container": "#ffdad6",
              "on-tertiary": "#ffffff", "primary": "#041627",
              "on-primary-container": "#8192a7"
            },
            borderRadius: { DEFAULT: "1rem", lg: "2rem", xl: "3rem", full: "9999px" },
            spacing: {
              "margin-desktop": "64px", "stack-md": "24px", "stack-lg": "48px",
              "stack-sm": "12px", "margin-mobile": "20px", "gutter": "24px",
              "container-max": "1200px", "unit": "8px"
            },
            fontFamily: {
              "label-sm": ["Quicksand"], "caption": ["Quicksand"], "display-lg": ["Quicksand"],
              "body-lg": ["Quicksand"], "headline-lg-mobile": ["Quicksand"],
              "headline-lg": ["Quicksand"], "title-md": ["Quicksand"], "body-md": ["Quicksand"]
            },
            fontSize: {
              "label-sm": ["14px", {lineHeight: "20px", letterSpacing: "0.01em", fontWeight: "600"}],
              "caption": ["12px", {lineHeight: "16px", fontWeight: "500"}],
              "display-lg": ["40px", {lineHeight: "48px", letterSpacing: "-0.02em", fontWeight: "700"}],
              "body-lg": ["18px", {lineHeight: "28px", fontWeight: "500"}],
              "headline-lg-mobile": ["24px", {lineHeight: "32px", fontWeight: "600"}],
              "headline-lg": ["32px", {lineHeight: "40px", fontWeight: "600"}],
              "title-md": ["20px", {lineHeight: "28px", fontWeight: "600"}],
              "body-md": ["16px", {lineHeight: "24px", fontWeight: "400"}]
            }
          },
        },
      }
    </script>
<style>
        body { background-color: #f9f9ff; font-family: 'Quicksand', sans-serif; overflow-x: hidden; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .chat-container { height: calc(100vh - 128px); scrollbar-width: none; }
        .chat-container::-webkit-scrollbar { display: none; }
        .message-bubble { box-shadow: 0 10px 30px rgba(26, 43, 60, 0.05); max-width: 85%; }
        .typing-dot { animation: typing 1.4s infinite ease-in-out; }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typing { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
        .glass-header { background: rgba(249, 249, 255, 0.8); backdrop-filter: blur(12px); }
        .fade-in { animation: fadeIn 0.3s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        @media (min-width: 768px) { .message-bubble { max-width: 60%; } }
    </style>
<base target="_blank">
</head>
<body class="bg-surface text-on-surface">

<!-- Top Navigation Bar -->
<header class="fixed top-0 left-0 right-0 z-50 glass-header">
<div class="flex items-center justify-between px-margin-mobile h-16 w-full max-w-container-max mx-auto">
<a href="{% url 'directory' %}" class="transition-all duration-200 active:scale-95 hover:opacity-80">
<span class="material-symbols-outlined text-primary">arrow_back</span>
</a>
<div class="flex flex-col items-center">
<span class="font-title-md text-title-md text-primary tracking-tight">Whisper Thread</span>
<div class="flex items-center gap-1 bg-secondary-container/30 px-3 py-0.5 rounded-full mt-0.5">
<span class="material-symbols-outlined text-[14px] text-secondary" style="font-variation-settings: 'FILL' 1;">lock</span>
<span class="text-[10px] uppercase font-bold tracking-wider text-secondary">Anonymous</span>
</div>
</div>
<div class="w-10 h-10 rounded-full border-2 border-primary/10 flex items-center justify-center bg-surface-container overflow-hidden">
<img class="w-full h-full object-cover" src="https://ui-avatars.com/api/?name={{ leader.name|urlencode }}&background=4a6549&color=fff&size=80" alt="{{ leader.name }}">
</div>
</div>
</header>

<!-- Main Chat Canvas -->
<main class="pt-20 pb-32 w-full max-w-[720px] mx-auto px-margin-mobile chat-container overflow-y-auto" id="chat-container">
<div class="flex flex-col gap-stack-md" id="messages-area">

<!-- Date Indicator -->
<div class="flex justify-center my-stack-sm">
<span class="font-label-sm text-label-sm text-on-surface-variant/60 bg-surface-container-low px-4 py-1 rounded-full">Today</span>
</div>

{% for message in messages %}
{% if message.sender_type == 'leader' %}
<!-- Leader Message -->
<div class="flex flex-col items-start gap-1 fade-in">
<div class="flex items-center gap-2 mb-1">
<div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center">
<span class="material-symbols-outlined text-[14px] text-white" style="font-variation-settings: 'FILL' 1;">verified_user</span>
</div>
<span class="font-label-sm text-label-sm text-primary">{{ leader.name }}</span>
</div>
<div class="message-bubble bg-white border border-primary/5 rounded-t-lg rounded-br-lg rounded-bl-[4px] px-4 py-3">
<p class="font-body-md text-body-md text-on-surface">{{ message.body }}</p>
</div>
<span class="font-caption text-caption text-on-surface-variant/50 ml-1">{{ message.created_at|time:"h:i A" }}</span>
</div>
{% else %}
<!-- Anonymous User Message -->
<div class="flex flex-col items-end gap-1 fade-in">
<div class="flex items-center gap-2 mb-1">
<span class="font-label-sm text-label-sm text-secondary">You (Anonymous)</span>
<div class="w-6 h-6 rounded-full bg-secondary-container flex items-center justify-center">
<span class="material-symbols-outlined text-[14px] text-on-secondary-container">cloud</span>
</div>
</div>
<div class="message-bubble bg-secondary text-white rounded-t-lg rounded-bl-lg rounded-br-[4px] px-4 py-3">
<p class="font-body-md text-body-md">{{ message.body }}</p>
</div>
<span class="font-caption text-caption text-on-surface-variant/50 mr-1">{{ message.created_at|time:"h:i A" }}</span>
</div>
{% endif %}
{% empty %}
<!-- Welcome Message from Leader -->
<div class="flex flex-col items-start gap-1 fade-in">
<div class="flex items-center gap-2 mb-1">
<div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center">
<span class="material-symbols-outlined text-[14px] text-white" style="font-variation-settings: 'FILL' 1;">verified_user</span>
</div>
<span class="font-label-sm text-label-sm text-primary">{{ leader.name }}</span>
</div>
<div class="message-bubble bg-white border border-primary/5 rounded-t-lg rounded-br-lg rounded-bl-[4px] px-4 py-3">
<p class="font-body-md text-body-md text-on-surface">Hello. I am here to listen. This space is entirely confidential and your identity is hidden from me. What's on your mind today?</p>
</div>
<span class="font-caption text-caption text-on-surface-variant/50 ml-1">{{ conversation.created_at|time:"h:i A" }}</span>
</div>
{% endfor %}

<!-- Typing Indicator -->
<div class="flex items-center gap-2 mt-stack-sm opacity-80" id="typing-indicator" style="display: none;">
<div class="flex gap-1 bg-surface-container px-3 py-2 rounded-full">
<div class="w-1.5 h-1.5 rounded-full bg-primary/40 typing-dot"></div>
<div class="w-1.5 h-1.5 rounded-full bg-primary/40 typing-dot"></div>
<div class="w-1.5 h-1.5 rounded-full bg-primary/40 typing-dot"></div>
</div>
<span class="font-label-sm text-label-sm text-on-surface-variant italic" id="typing-label">Leader is typing...</span>
</div>
</div>
</main>

<!-- Bottom Input Bar -->
<footer class="fixed bottom-0 left-0 right-0 bg-surface/90 backdrop-blur-md pb-safe">
<div class="max-w-[720px] mx-auto px-margin-mobile py-4">
<div class="flex items-center gap-2 mb-3 justify-center">
<span class="material-symbols-outlined text-on-surface-variant/40 text-[16px]">visibility_off</span>
<span class="font-caption text-caption text-on-surface-variant/60">Leader cannot see who you are.</span>
</div>
<div class="flex items-end gap-3 bg-white border border-primary/10 rounded-lg p-2 shadow-sm focus-within:border-secondary transition-colors">
<button class="p-2 text-on-surface-variant hover:text-secondary transition-colors" type="button">
<span class="material-symbols-outlined">add_circle</span>
</button>
<textarea class="flex-1 py-2 px-1 border-none focus:ring-0 font-body-md text-body-md bg-transparent resize-none max-h-32" id="message-input" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" placeholder="Whisper your thoughts..." rows="1"></textarea>
<button class="w-10 h-10 rounded-full bg-secondary text-white flex items-center justify-center transition-all duration-200 active:scale-90 hover:shadow-lg hover:shadow-secondary/20" id="send-btn" type="button">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">send</span>
</button>
</div>
</div>
</footer>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const chatContainer = document.getElementById('chat-container');
    const messagesArea = document.getElementById('messages-area');
    const textarea = document.getElementById('message-input');
    const sendBtn = document.getElementById('send-btn');
    const typingIndicator = document.getElementById('typing-indicator');
    const typingLabel = document.getElementById('typing-label');

    const wsUrl = '{{ ws_url }}';
    const socket = new WebSocket(wsUrl);
    let typingTimeout;

    socket.onopen = function(e) {
        console.log('Connected to Whisper Line');
    };

    socket.onmessage = function(e) {
        const data = JSON.parse(e.data);

        if (data.type === 'message') {
            appendMessage(data);
            hideTyping();
        } 
        else if (data.type === 'typing') {
            if (data.is_typing) {
                typingLabel.textContent = 'Leader is typing...';
                typingIndicator.style.display = 'flex';
                chatContainer.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
            } else {
                hideTyping();
            }
        }
        else if (data.type === 'online') {
            console.log('Leader is online');
        }
        else if (data.type === 'offline') {
            console.log('Leader went offline');
        }
    };

    socket.onclose = function(e) {
        console.log('Disconnected. Reconnecting...');
        setTimeout(() => location.reload(), 3000);
    };

    socket.onerror = function(e) {
        console.error('WebSocket error:', e);
    };

    sendBtn.addEventListener('click', () => {
        const text = textarea.value.trim();
        if (!text || socket.readyState !== WebSocket.OPEN) return;

        socket.send(JSON.stringify({
            type: 'message',
            message: text
        }));

        textarea.value = '';
        textarea.style.height = 'auto';
        stopTyping();
    });

    textarea.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendBtn.click();
        }
    });

    textarea.addEventListener('input', () => {
        if (socket.readyState === WebSocket.OPEN) {
            socket.send(JSON.stringify({ type: 'typing', is_typing: true }));
            clearTimeout(typingTimeout);
            typingTimeout = setTimeout(stopTyping, 2000);
        }
    });

    function stopTyping() {
        if (socket.readyState === WebSocket.OPEN) {
            socket.send(JSON.stringify({ type: 'typing', is_typing: false }));
        }
    }

    function appendMessage(data) {
        const isMe = data.is_me;
        const div = document.createElement('div');
        div.className = 'flex flex-col gap-1 fade-in ' + (isMe ? 'items-end' : 'items-start');

        if (isMe) {
            div.innerHTML = `
                <div class="flex items-center gap-2 mb-1">
                    <span class="font-label-sm text-label-sm text-secondary">You (Anonymous)</span>
                    <div class="w-6 h-6 rounded-full bg-secondary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-[14px] text-on-secondary-container">cloud</span>
                    </div>
                </div>
                <div class="message-bubble bg-secondary text-white rounded-t-lg rounded-bl-lg rounded-br-[4px] px-4 py-3">
                    <p class="font-body-md text-body-md">${escapeHtml(data.message)}</p>
                </div>
                <span class="font-caption text-caption text-on-surface-variant/50 mr-1">${data.timestamp}</span>
            `;
        } else {
            div.innerHTML = `
                <div class="flex items-center gap-2 mb-1">
                    <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[14px] text-white" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                    </div>
                    <span class="font-label-sm text-label-sm text-primary">${escapeHtml(data.sender_name)}</span>
                </div>
                <div class="message-bubble bg-white border border-primary/5 rounded-t-lg rounded-br-lg rounded-bl-[4px] px-4 py-3">
                    <p class="font-body-md text-body-md text-on-surface">${escapeHtml(data.message)}</p>
                </div>
                <span class="font-caption text-caption text-on-surface-variant/50 ml-1">${data.timestamp}</span>
            `;
        }

        messagesArea.insertBefore(div, typingIndicator);
        chatContainer.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
    }

    function hideTyping() {
        typingIndicator.style.display = 'none';
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    chatContainer.scrollTop = chatContainer.scrollHeight;
});
</script>
</body>
</html>